{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Write(./scratch/**)",
      "Edit(./scratch/**)",
      "Bash(git log:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(python3 harness/tools/:*)",
      "Bash(databricks bundle validate:*)",
      "Bash(databricks bundle summary:*)",
      "Bash(databricks catalogs list:*)",
      "Bash(databricks catalogs get:*)",
      "Bash(databricks schemas list:*)",
      "Bash(databricks schemas get:*)",
      "Bash(databricks tables list:*)",
      "Bash(databricks tables get:*)",
      "Bash(databricks jobs list:*)",
      "Bash(databricks jobs get:*)",
      "Bash(databricks jobs list-runs:*)",
      "Bash(databricks jobs get-run:*)",
      "Bash(databricks pipelines list-pipelines:*)",
      "Bash(databricks pipelines get:*)",
      "Bash(databricks pipelines list-pipeline-events:*)"
    ],
    "deny": [
      "Edit(./src/**)",
      "Edit(./resources/**)",
      "Edit(./tests/**)",
      "Edit(./docs/**)",
      "Edit(./databricks.yml)",
      "Edit(./harness/**)",
      "Edit(./.claude/**)",
      "Write(./src/**)",
      "Write(./resources/**)",
      "Write(./tests/**)",
      "Write(./docs/**)",
      "Write(./harness/**)",
      "Write(./.claude/**)",
      "WebFetch",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(databricks bundle deploy:*)",
      "Bash(databricks bundle run:*)",
      "Bash(databricks jobs run-now:*)",
      "Bash(databricks pipelines start-update:*)"
    ]
  }
}
